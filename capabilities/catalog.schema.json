{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HAGOV capability catalog candidate schema",
  "oneOf": [
    { "$ref": "#/$defs/Root" },
    { "$ref": "#/$defs/Domain" }
  ],
  "$defs": {
    "Root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "candidate_only", "domains"],
      "properties": {
        "format": { "const": "hagov.capability-root.v1" },
        "version": { "const": 1 },
        "candidate_only": { "const": true },
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "intents", "manifest_path", "sha256"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
              "description": { "type": "string", "minLength": 1 },
              "intents": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }
              },
              "manifest_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "Domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "domain_id", "capabilities"],
      "properties": {
        "format": { "const": "hagov.capability-domain.v1" },
        "domain_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "intents", "description", "risk_class", "side_effects", "document_path", "sha256", "requires", "tool_requirements"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
              "intents": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }
              },
              "description": { "type": "string", "minLength": 1 },
              "risk_class": { "const": "R0" },
              "side_effects": { "const": false },
              "document_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "requires": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" }
              },
              "tool_requirements": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]+$" }
              }
            }
          }
        }
      }
    }
  }
}
